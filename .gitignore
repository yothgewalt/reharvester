# Private styling
.claude
CLAUDE.md
*.so*

# Go
/bin/
/build/
/dist/
/vendor/
*.exe
*.dll
*.dylib
*.test
*.out
coverage.out
.go-version

# Next.js / TypeScript
/node_modules/
/web/.next/
/web/out/
/web/build/
/web/dist/
*.tsbuildinfo
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vercel

.DS_Store

# graft's local graph cache — regenerable, not committed (run `graft build`).
graft/

# Local corpus + artefacts (regenerable: --harvest)
/.reharvester/

# Playwright MCP scratch output
.playwright-mcp/

# The embedded UI: the release script fills this from web/dist. Only the
# placeholder is tracked, so the go:embed directive still compiles from a
# clean checkout.
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep

# npm distribution: the per-platform binaries are cross-compiled into
# npm/reharvester/bin/<platform>/ by scripts/release.sh. The pattern ignores
# those directories while leaving bin/reharvester.js — the launcher — tracked.
/npm/reharvester/bin/*/
/npm/**/*.tgz
# Copied from the repository LICENSE by scripts/release.sh so each package
# ships the licence its package.json declares. Tracking it would create a
# second copy free to drift from the real one.
/npm/reharvester/LICENSE
